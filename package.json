{
  "name": "lab-qr-gps-attendance-portal",
  "version": "6.2.2",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && wrangler deploy --keep-vars",
    "typecheck": "tsc --noEmit",
    "test": "node tests/regression.cjs && node tests/financial-regression.cjs && node tests/database-regression.cjs && node tests/cloudflare-runtime.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "framer-motion": "^11.18.2",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.469.0",
    "next": "^15.5.29",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@opennextjs/cloudflare": "^1.20.17",
    "@types/node": "^20.17.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.161.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
